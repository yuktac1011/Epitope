# FedShield Frontend Environment Variables

# Backend API Base URL
# For local development with FastAPI running on port 8000:
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# When deployed to Vercel, set this variable in Vercel Project Settings to your deployed backend URL:
# NEXT_PUBLIC_API_URL=https://<your-render-backend-name>.onrender.com
